# Copy these values into your deployment provider's secret manager; do not add a .env file to Git.
PORT=8787
CORS_ORIGIN=http://localhost:8085

# First model: photo → structured, evidence-based context
GEMINI_API_KEY=replace-me
# A lightweight vision model keeps the two-stage demo responsive on free-tier keys.
GEMINI_VISION_MODEL=gemini-flash-lite-latest
GEMINI_VISION_FALLBACK_MODEL=gemini-flash-lite-latest
# Structured multimodal responses can occasionally take longer on the free tier.
GEMINI_REQUEST_TIMEOUT_MS=45000

# Second call: structured context → three broader, CEFR-aligned scenarios.
# This call deliberately uses the same server-side Gemini API key.
GEMINI_SCENARIO_MODEL=gemini-2.5-flash-lite
# Gemini limits new projects' access to 2.5 models. Use this only if 2.5 is unavailable.
GEMINI_SCENARIO_FALLBACK_MODEL=gemini-3.5-flash-lite

# Optional hackathon-only shared token. Replace with authenticated user tokens before production.
LIFELENS_API_TOKEN=
