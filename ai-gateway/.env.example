# Copy these values into your deployment provider's secret manager; do not add a .env file to Git.
PORT=8787
CORS_ORIGIN=http://localhost:8085

# First model: photo → structured, evidence-based context
GEMINI_API_KEY=replace-me
GEMINI_VISION_MODEL=gemini-flash-latest
GEMINI_VISION_FALLBACK_MODEL=gemini-flash-lite-latest

# Second AI agent: structured context → expanded, CEFR-aligned mission.
# Gemini Flash-Lite keeps the demo fully live even before an OpenAI key is added.
GEMINI_SCENARIO_MODEL=gemini-flash-lite-latest

# Optional provider upgrade: if defined, the scenario step uses OpenAI instead.
OPENAI_API_KEY=
OPENAI_SCENARIO_MODEL=gpt-5-mini

# Optional hackathon-only shared token. Replace with authenticated user tokens before production.
LIFELENS_API_TOKEN=
